<Window x:Class="SongDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Завантаження пісень через потоки"
        Width="620"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">

        <TextBlock Text="Папка для збереження" FontWeight="SemiBold"/>
        <DockPanel Margin="0,4,0,15">
            <Button x:Name="SelectFolderButton"
                    Content="Обрати..."
                    Width="100"
                    DockPanel.Dock="Right"
                    Click="SelectFolderButton_Click"/>
            <TextBox x:Name="PathTextBox" IsReadOnly="True" Height="26" Margin="0,0,8,0"/>
        </DockPanel>

        <TextBlock x:Name="CounterText" Text="0/0" FontWeight="SemiBold"/>
        <ProgressBar x:Name="DownloadProgress" Height="18" Margin="0,5,0,15"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="SequentialButton"
                    Content="Послідовно"
                    Width="160"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="SequentialButton_Click"/>
            <Button x:Name="ThreadsButton"
                    Content="Потоками"
                    Width="160"
                    Height="36"
                    Click="ThreadsButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="SequentialTimeText" Text="Послідовно: —"/>
        <TextBlock x:Name="ThreadsTimeText" Text="Потоками: —" Margin="0,0,0,15"/>

        <ListBox x:Name="LogList" Height="180"/>

    </StackPanel>
</Window>
